ROOTTALE_API_KEY=
ROOTTALE_API_BASE=https://api.roottale.com
ROOTTALE_MEDIA_ORIGIN=https://root-cdn.com
NEXT_PUBLIC_ROOTTALE_SITE_ID=
NEXT_DEV_ALLOWED_ORIGINS=

# 사이트 내용: ROOTTALE_API_KEY는 서버 전용 읽기 키, ROOTTALE_API_BASE는 CMS API 주소,
# NEXT_PUBLIC_ROOTTALE_SITE_ID는 조회 대상 사이트 ID입니다. 키가 없거나 조회에 실패하면
# 공유 안내는 코드 기본값으로 표시합니다. 별도 SITE_CONTENT_MODE는 사용하지 않습니다.
# 실제화면 편집 iframe·브리지에 추가로 허용할 관리자 origin(쉼표 구분).
# 기본 허용: https://admin.roottale.com, https://admin.web.ai.kr
ROOTTALE_VISUAL_EDITOR_ORIGINS=
