    "routes": [
      {
        "routeKey": "column",
        "label": "블로그 목록",
        "source": {
          "kind": "model-list",
          "modelKey": "column"
        },
        "defaults": {
          "title": "광주 남구 마디클리닉 블로그",
          "description": "광주 남구 마디클리닉 이경무 대표원장이 통증의 원인과 비수술 중점치료를 직접 씁니다. 영상유도하 통증중재시술 의료기관."
        },
        "fallback": {
          "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
        },
        "supportedFields": [
          "title",
          "description",
          "ogImage",
          "ogImageAlt",
          "noindex",
          "nofollow"
        ]
      },
      {
        "routeKey": "reviews",
