{
  "version": 5,
  "pages": [],
  "models": [
    {
      "modelKey": "faq",
      "preset": "article",
      "listPath": "/faq",
      "templateKey": "faq",
      "allowedQueryFields": [],
      "shared": false
    },
    {
      "modelKey": "column",
      "preset": "article",
      "listPath": "/column",
      "templateKey": "column",
      "allowedQueryFields": [],
      "shared": false
    },
    {
      "modelKey": "reviews",
      "preset": "article",
      "listPath": "/reviews",
      "detailPath": "/reviews/:slug",
      "templateKey": "reviews",
      "allowedQueryFields": [],
      "shared": false
    }
  ],
  "dynamicPages": [],
  "exposureSlots": [
    {
      "key": "site-popup",
      "kind": "popup",
      "variants": [
        "card",
        "image-card",
        "image"
      ],
      "assetKinds": [
        "image"
      ],
      "pathPrefixes": [
        "/"
      ],
      "repeatOptions": [
        "always",
        "session",
        "day",
        "never"
      ],
      "runtimeVersion": 2,
      "homePaths": [
        "/column",
        "/faq",
        "/reviews"
      ],
      "pathRules": [
        {
          "path": "/",
          "match": "exact"
        }
      ],
      "label": "커뮤니티 팝업",
      "description": "블로그·자주 묻는 질문·후기 첫 화면의 PC·모바일 팝업. 상세 글에서는 표시하지 않습니다.",
      "placement": "popup",
      "imageDimensions": {
        "desktop": {
          "width": 600,
          "height": 600
        },
        "mobile": {
          "width": 750,
          "height": 750
        }
      },
      "sizes": [
        "small",
        "medium",
        "large"
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "routes": [
      {
        "routeKey": "column",
        "label": "블로그 목록",
        "source": {
          "kind": "model-list",
          "modelKey": "column"
        },
        "defaults": {
          "title": "광주 남구 마디클리닉 블로그",
          "description": "광주 남구 마디클리닉 이경무 대표원장이 통증의 원인과 비수술 중점치료를 직접 씁니다. 영상유도하 통증중재시술 의료기관."
        },
        "fallback": {
          "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
        },
        "supportedFields": [
          "title",
          "description",
          "ogImage",
          "ogImageAlt",
          "noindex",
          "nofollow"
        ]
      },
      {
        "routeKey": "reviews",
        "label": "치료후기 목록",
        "source": {
          "kind": "model-list",
          "modelKey": "reviews"
        },
        "defaults": {
          "title": "치료후기 | 광주 남구 마디클리닉",
          "description": "광주 남구 마디클리닉에서 치료받은 분들이 직접 남긴 치료 경험담입니다."
        },
        "fallback": {
          "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
        },
        "supportedFields": [
          "title",
          "description",
          "ogImage",
          "ogImageAlt",
          "noindex",
          "nofollow"
        ]
      },
      {
        "routeKey": "faq",
        "label": "FAQ 목록",
        "source": {
          "kind": "model-list",
          "modelKey": "faq"
        },
        "defaults": {
          "title": "질환별 자주 묻는 질문 | 광주 남구 마디클리닉",
          "description": "광주 남구 마디클리닉 이경무 대표원장이 진료실에서 자주 받는 질문에 답합니다. 통증의 원인과 검사, 비수술 중점치료와 경과를 확인하세요."
        },
        "fallback": {
          "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
        },
        "supportedFields": [
          "title",
          "description",
          "ogImage",
          "ogImageAlt",
          "noindex",
          "nofollow"
        ]
      }
    ],
    "posts": {
      "supportedFields": [
        "title",
        "description",
        "ogImage",
        "ogImageAlt",
        "noindex",
        "nofollow"
      ],
      "modelKeys": [
        "column",
        "reviews",
        "faq"
      ],
      "titleTemplates": {
        "column": "%s | 광주 남구 마디클리닉 블로그",
        "reviews": "%s | 치료후기 | 광주 남구 마디클리닉",
        "faq": "%s | 광주 남구 마디클리닉"
      },
      "defaultRules": {
        "column": {
          "title": {
            "removeEmDashes": true
          },
          "description": {
            "removeEmDashes": true,
            "maxLength": 160,
            "fallback": "광주 남구 마디클리닉 이경무 대표원장이 쓰는 통증·비수술 치료 칼럼입니다."
          },
          "useFirstBodyImage": true,
          "imageAltSource": "title",
          "normalizeCloudflareImages": true,
          "fallback": {
            "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
          }
        },
        "reviews": {
          "title": {
            "removeEmDashes": true
          },
          "description": {
            "removeEmDashes": true,
            "maxLength": 180,
            "fallback": "광주 남구 마디클리닉에서 치료받은 분들이 직접 남긴 치료 경험담입니다."
          },
          "useFirstBodyImage": true,
          "imageAltSource": "title",
          "normalizeCloudflareImages": true,
          "fallback": {
            "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
          }
        },
        "faq": {
          "title": {
            "stripLeadingLabel": "question",
            "replaceLineBreakTokens": true,
            "normalizeWhitespace": true
          },
          "description": {
            "stripLeadingLabel": "answer",
            "replaceLineBreakTokens": true,
            "normalizeWhitespace": true,
            "maxLength": 160,
            "ellipsis": "…",
            "fallback": "광주 남구 마디클리닉 이경무 대표원장이 진료실에서 자주 받는 질문에 답합니다. 통증의 원인과 검사, 비수술 중점치료와 경과를 확인하세요."
          },
          "useFirstBodyImage": true,
          "imageAltSource": "title",
          "normalizeCloudflareImages": true,
          "fallback": {
            "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
          }
        }
      }
    },
    "terms": {
      "supportedFields": [
        "title",
        "description",
        "ogImage",
        "ogImageAlt",
        "noindex",
        "nofollow"
      ],
      "modelKeys": [
        "column",
        "faq"
      ],
      "titleTemplates": {
        "column": "%s",
        "faq": "%s 자주 묻는 질문 | 광주 남구 마디클리닉"
      },
      "defaultRules": {
        "column": {
          "description": {
            "fallback": "광주 남구 마디클리닉 이경무 대표원장이 통증의 원인과 비수술 중점치료를 직접 씁니다. 영상유도하 통증중재시술 의료기관."
          },
          "useTermImage": false,
          "imageAltSource": "title",
          "normalizeCloudflareImages": true,
          "fallback": {
            "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
          }
        },
        "faq": {
          "description": {
            "fallbackWithParent": "%s의 증상·검사·치료와 경과에 관해 자주 묻는 질문입니다.",
            "fallbackWithoutParent": "%s에 관해 진료실에서 자주 받는 질문과 답변입니다."
          },
          "useTermImage": false,
          "imageAltSource": "title",
          "normalizeCloudflareImages": true,
          "fallback": {
            "ogImage": "https://gwangju2020blog.madiclinic.co.kr/opengraph-image.png"
          }
        }
      }
    }
  },
  "fixedPatterns": [
    {
      "key": "column-footer-image",
      "label": "블로그 하단 이미지",
      "location": "모든 블로그 글에서 의료 콘텐츠 안내 아래, 블로그 목록 바로 위에 표시됩니다. 후기·FAQ에는 표시되지 않습니다."
    }
  ]
}
